# Salin menjadi .env lalu isi. Jangan commit .env.

# MySQL 8 lokal (8.0.16+). Format: mysql://USER:PASSWORD@HOST:3306/nixtio_watch
DATABASE_URL=""

# Auth: secret acak minimal 32 karakter, mis.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# true di lokal; set false di produksi setelah akun yang dibutuhkan dibuat
ALLOW_REGISTRATION="true"

# Opsional, hanya untuk fitur P1 (pencarian TMDB). Server-side saja.
TMDB_API_KEY=""
